From: Sergey Syzonov <ssyzonov@larch-networks.com>
Date: Wed, 23 Sep 2026 18:31:51 +0300
Subject: [PATCH] i2c: allow 32 KiB i2c-dev transactions and scale the mv64xxx
 timeout for large transfers

Some I2C slave devices require transactions far larger than the
hardcoded i2c-dev limit. PoE PSE controllers such as the Realtek
RTL8239 take their firmware image as one large I2C_RDWR write of about
25 KiB; with the stock 8 KiB cap the firmware upload is impossible from
userspace.

Raise the i2c-dev message size limit from 8192 bytes to 32 KiB, and let
the mv64xxx adapter scale its transfer timeout for messages larger than
4 KiB (about one second per 4 KiB, restored afterwards), since the
fixed 1 s adapter timeout is too short for such transfers. The scaling
covers both the interrupt-driven and the atomic (polling) wait paths.

---
 drivers/i2c/busses/i2c-mv64xxx.c | 10 ++++++++++
 drivers/i2c/i2c-dev.c            | 10 +++++-----
 2 files changed, 15 insertions(+), 5 deletions(-)

diff --git a/drivers/i2c/busses/i2c-mv64xxx.c b/drivers/i2c/busses/i2c-mv64xxx.c
index 13e9bde..47f1c83 100644
--- a/drivers/i2c/busses/i2c-mv64xxx.c
+++ b/drivers/i2c/busses/i2c-mv64xxx.c
@@ -668,6 +668,7 @@ mv64xxx_i2c_execute_msg(struct mv64xxx_i2c_data *drv_data, struct i2c_msg *msg,
 				int is_last)
 {
 	unsigned long	flags;
+	int		timeout_bak = 0;
 
 	spin_lock_irqsave(&drv_data->lock, flags);
 
@@ -678,11 +679,20 @@ mv64xxx_i2c_execute_msg(struct mv64xxx_i2c_data *drv_data, struct i2c_msg *msg,
 	mv64xxx_i2c_send_start(drv_data);
 	spin_unlock_irqrestore(&drv_data->lock, flags);
 
+	/* Patch for loading the RTL8239 PSE firmware: allow ~1 s per 4 KiB */
+	if (msg->len > 0x1000) {
+		timeout_bak = drv_data->adapter.timeout;
+		drv_data->adapter.timeout = (msg->len / 0x1000 + 1) * HZ;
+	}
+
 	if (!drv_data->atomic)
 		mv64xxx_i2c_wait_for_completion(drv_data);
 	else
 		mv64xxx_i2c_wait_polling(drv_data);
 
+	if (msg->len > 0x1000)
+		drv_data->adapter.timeout = timeout_bak;
+
 	return drv_data->rc;
 }
 
diff --git a/drivers/i2c/i2c-dev.c b/drivers/i2c/i2c-dev.c
index e9577f9..f14b5f4 100644
--- a/drivers/i2c/i2c-dev.c
+++ b/drivers/i2c/i2c-dev.c
@@ -143,8 +143,8 @@ static ssize_t i2cdev_read(struct file *file, char __user *buf, size_t count,
 	if (!i2c_check_functionality(client->adapter, I2C_FUNC_I2C))
 		return -EOPNOTSUPP;
 
-	if (count > 8192)
-		count = 8192;
+	if (count > 32 * 1024)
+		count = 32 * 1024;
 
 	tmp = kzalloc(count, GFP_KERNEL);
 	if (tmp == NULL)
@@ -171,8 +171,8 @@ static ssize_t i2cdev_write(struct file *file, const char __user *buf,
 	if (!i2c_check_functionality(client->adapter, I2C_FUNC_I2C))
 		return -EOPNOTSUPP;
 
-	if (count > 8192)
-		count = 8192;
+	if (count > 32 * 1024)
+		count = 32 * 1024;
 
 	tmp = memdup_user(buf, count);
 	if (IS_ERR(tmp))
@@ -257,7 +257,7 @@ static noinline int i2cdev_ioctl_rdwr(struct i2c_client *client,
 	res = 0;
 	for (i = 0; i < nmsgs; i++) {
 		/* Limit the size of the message to a sane amount */
-		if (msgs[i].len > 8192) {
+		if (msgs[i].len > 32 * 1024) {
 			res = -EINVAL;
 			break;
 		}
-- 
2.34.1

