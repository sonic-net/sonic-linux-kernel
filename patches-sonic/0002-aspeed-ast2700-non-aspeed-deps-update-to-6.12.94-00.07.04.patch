+#define NIST_TRNG_REG_EDU_VSTAT_SLICE_RWI3(x)         (((x) >> 15) & 1)
+#define NIST_TRNG_REG_EDU_VSTAT_SLICE_RWI2(x)         (((x) >> 14) & 1)
