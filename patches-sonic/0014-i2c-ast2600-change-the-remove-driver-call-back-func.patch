 	.probe = ast2600_i2c_probe,
-	.remove_new = ast2600_i2c_remove,
+	.remove = ast2600_i2c_remove,
 	.driver = {
 		.name = KBUILD_MODNAME,
 		.of_match_table = ast2600_i2c_bus_of_table,
