 # MHI
 obj-y				+= mhi/
diff --git a/drivers/char/hw_random/Kconfig b/drivers/char/hw_random/Kconfig
--- a/drivers/char/hw_random/Kconfig	2026-06-19 11:42:39.000000000 +0000
+++ b/drivers/char/hw_random/Kconfig	2026-09-09 15:51:30.808448261 +0000
@@ -588,6 +588,21 @@
 
 	  If unsure, say Y.
 
+config HW_RANDOM_ASPEED
+	tristate "Aspeed Random Number Generator support"
+	depends on ARCH_ASPEED
