+		}
+
+		err = phy_set_speed(priv->sgmii, speed);
+		if (err)
+			dev_err(priv->dev, "Failed to force sgmii speed\n");
+	} else {
+		err = phy_set_speed(priv->sgmii, 0);
+		if (err)
+			dev_err(priv->dev, "Failed to enable sgmii Nway\n");
+	}
+
+err_out:
+	if (fixed_link_node)
+		of_node_put(fixed_link_node);
+
+	return err;
