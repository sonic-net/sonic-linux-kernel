 obj-$(CONFIG_EEPROM_EE1004)	+= ee1004.o
 obj-$(CONFIG_EEPROM_SFF_8436)	+= sff_8436_eeprom.o
 obj-$(CONFIG_EEPROM_OPTOE)	+= optoe.o
